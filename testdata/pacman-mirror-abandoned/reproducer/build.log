[2/2] STEP 16/20: LABEL ai.opencharly.description='{"candy":[{"origin":"candy:pacman-mirror-repro","description":"Deterministic reproducer for the pacman mirror-abandonment class. It reaches pacman'\''s own sentence \"warning: too many errors from \u003chost\u003e, skipping for the remainder of this transaction\" by putting a server that refuses every connection FIRST in each mirrorlist and then reinstalling packages the base image already carries into a fresh --cachedir, so pacman must fetch real payloads, fails three times against the dead server, abandons it for the rest of the transaction, and completes from the next mirror. The transaction exits 0.","plan":[{"run":"disable pacman'\''s scriptlet network sandbox (the CachyOS base-image precondition)","plugin":"command","id":"mirror-repro-sandbox-disabled","plugin_input":{"command":"set -eu\ngrep -q '\''^DisableSandboxNetwork'\'' /etc/pacman.conf || sed -i '\''/^\\[options\\]/a DisableSandboxNetwork'\'' /etc/pacman.conf\n"},"intent_do":"act"},{"run":"sync every database while every configured mirror is still reachable","plugin":"command","id":"mirror-repro-sync","plugin_input":{"command":"set -eu\npacman -Sy --noconfirm\n"},"intent_do":"act"},{"run":"put an unreachable server first and reinstall current packages from a fresh cachedir","plugin":"command","id":"mirror-repro-abandon","plugin_input":{"command":"set -eu\nfor f in /etc/pacman.d/*mirrorlist; do\n    [ -f \"$f\" ] || continue\n    printf '\''Server = http://127.0.0.1:1/$repo/os/$arch\\n'\'' | cat - \"$f\" \u003e \"$f.tmp\"\n    mv \"$f.tmp\" \"$f\"\ndone\nrm -rf /tmp/mirror-repro-cache\nmkdir -p /tmp/mirror-repro-cache\npacman -S --noconfirm --cachedir /tmp/mirror-repro-cache glibc gcc libgfortran libgcc libstdc++\n"},"intent_do":"act"},{"check":"pacman is present (the reproducer steps above need it)","plugin":"command","id":"mirror-repro-pacman-present","context":["build"],"plugin_input":{"command":"pacman --version"},"intent_do":"assert","exit_status":0}]}]}'
