# golangci-lint v2 config for the command:check plugin candy. Its errcheck policy follows
# charly/.golangci.yml's for the fmt.Fprint family and deliberately does NOT carry over that
# config's (io.Closer).Close exclusion — see the last paragraph for why.
#
# plugin-check is a CLI-output-heavy command relocated from charly's check family (P12), so it uses
# the SAME fmt.Fprint(os.Stdout/os.Stderr/tabwriter) idiom charly does; writing to stdout/stderr/
# a string-builder never produces an actionable error in a CLI. Genuinely actionable errors
# (os.WriteFile, exec.Cmd.Run, fmt.Sscanf, io.Copy, …) are NOT excluded and ARE handled, and
# neither is (io.Closer).Close: every Close in this module is handled explicitly at its own site (a
# nested `_ =`, a returned error, or a per-site `//nolint:errcheck` where the discard is
# deliberate), so a blanket Close exclusion suppressed NOTHING (removing it leaves the run at
# "0 issues") while standing ready to absorb the next genuinely unchecked Close. Keeps the
# standard set (errcheck, govet, ineffassign, staticcheck, unused).
version: "2"

linters:
  settings:
    errcheck:
      exclude-functions:
        - fmt.Fprint
        - fmt.Fprintf
        - fmt.Fprintln

# golangci-lint v2 moved formatters OUT of `linters:` into their own top-level block.
# Without this the run reports "0 issues." over a file `gofmt -l` rejects. This module
# has its own config, so the root config does NOT apply to it — the closest one wins.
formatters:
  enable:
    - gofmt
